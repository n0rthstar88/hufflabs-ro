+/// HuffLabs RO: refreshweather "<map>"{,<cleared>};
+/// Shows a map's weather flags to the players already on it. Weather is a one-off client effect sent
+/// when a map loads, so new weather can be added in place (cleared = 0, default), but taking
+/// weather away needs the client to reload the map (cleared = 1, like @refresh for each player).
+BUILDIN_FUNC(refreshweather)
+{
+	const char *str = script_getstr(st, 2);
+	int16 m = map_mapname2mapid(str);
+	if (m < 0) {
+		ShowWarning("buildin_refreshweather: Invalid map name %s.\n", str);
+		return SCRIPT_CMD_FAILURE;
+	}
+	if (!(script_hasdata(st, 3) && script_getnum(st, 3))) {
+		clif_weather(m);
+		return SCRIPT_CMD_SUCCESS;
+	}
+	struct s_mapiterator* iter = mapit_getallusers();
+	for (map_session_data* sd = (map_session_data*)mapit_first(iter); mapit_exists(iter); sd = (map_session_data*)mapit_next(iter)) {
+		if (sd->m == m && sd->state.active && !sd->state.warping)
+			clif_refresh(sd);
+	}
+	mapit_free(iter);
+	return SCRIPT_CMD_SUCCESS;
+}
